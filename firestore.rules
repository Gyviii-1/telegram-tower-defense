rules_version = '2';

// Правила безопасности Firestore для игры Tower Defense.
// Задача: таблицу лидеров можно читать всем, но нельзя ломать —
// ни удалять, ни писать мусор. Каждый пишет только свой документ.
//
// Как применить: Firebase Console -> Firestore Database -> вкладка Rules ->
// вставить этот текст -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Таблица лидеров: читают все, но ЗАПИСЬ только через сервер
    // (Vercel API + Firebase Admin). Клиент напрямую писать не может.
    match /leaderboard/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    // Пользователи и роли (creator / tester / player).
    // Клиенту доступ закрыт полностью: роль отдаёт сервер (Vercel API).
    // Пишет и читает только сервисный аккаунт (бот/API обходят правила).
    match /users/{userId} {
      allow read, write: if false;
    }

    // Всё остальное в базе запрещено.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
